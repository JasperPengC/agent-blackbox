{
  "name": "dsh-agent-blackbox",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件：在侧栏打开 agent-blackbox 仪表盘，实时监视 / 回放 / 多会话成本总览（宿主进程内直出，不额外起进程）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "agent-observability", "agent-blackbox"],
  "license": "MIT",
  "author": "GlowStorm",
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
